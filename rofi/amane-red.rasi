configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    font: "JetBrainsMono Nerd Font 10";
}

* {
    background-color: #260b0fd9;
    text-color: #f5e1e4ff;
}

window {
    location: north;
    anchor: north;
    y-offset: 40px;
    width: 600px;
    border: 1px;
    border-color: #c4234596;
    border-radius: 12px;
    background-color: #260b0fd9;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 10px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 9px 12px;
    border: 1px;
    border-color: #c4234596;
    border-radius: 8px;
    background-color: #481520d9;
}

prompt {
    text-color: #f04462ff;
    background-color: transparent;
}

entry {
    text-color: #f5e1e4ff;
    background-color: transparent;
}

listview {
    lines: 9;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: #c423457a;
    text-color: #ffffffff;
    border: 1px;
    border-color: #ff80948c;
}

element-icon {
    size: 20px;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}
