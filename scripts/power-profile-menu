#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROFI_SINGLE="$SCRIPT_DIR/rofi-single"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Power profile" "$1"
    else
        printf 'Power profile: %s\n' "$1" >&2
    fi
}

# If Power Profiles Daemon is missing or disabled, keep the menu out of the
# user's way. The Amane bar independently hides its PWR chip on the same check.
if ! command -v powerprofilesctl >/dev/null 2>&1 \
    || ! command -v systemctl >/dev/null 2>&1 \
    || ! systemctl is-active --quiet power-profiles-daemon.service; then
    exit 0
fi
if ! [[ -x "$ROFI_SINGLE" ]]; then
    notify "Rofi is required for the profile menu."
    exit 1
fi

if ! available_output="$(powerprofilesctl list 2>/dev/null)"; then
    notify "Could not query power profiles. Check that power-profiles-daemon.service is running."
    exit 1
fi
current="$(powerprofilesctl get 2>/dev/null || true)"

options=()
add_profile() {
    local profile="$1" label="$2" description="$3"
    if printf '%s\n' "$available_output" | grep -Eq "^[[:space:]]*\\*?[[:space:]]*${profile}:"; then
        if [[ "$current" == "$profile" ]]; then
            options+=("${label} — ${description} (current)")
        else
            options+=("${label} — ${description}")
        fi
    fi
}

add_profile performance "Performance" "maximum responsiveness"
add_profile balanced "Balanced" "everyday use"
add_profile power-saver "Power saver" "lower energy use"

if ((${#options[@]} == 0)); then
    notify "No supported profiles were returned by powerprofilesctl list."
    exit 1
fi

choice="$(printf '%s\n' "${options[@]}" | "$ROFI_SINGLE" -dmenu -p "Power mode" -l "${#options[@]}" || true)"
[[ -n "$choice" ]] || exit 0

case "$choice" in
    Performance*) profile="performance" ;;
    Balanced*) profile="balanced" ;;
    Power\ saver*) profile="power-saver" ;;
    *) exit 1 ;;
esac

if powerprofilesctl set "$profile"; then
    notify "Switched to ${profile}."
else
    notify "Could not switch to ${profile}. Check the daemon and hardware support."
    exit 1
fi
