#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
AMANE_DIR="$CONFIG_HOME/amane"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/amane}"
mkdir -p "$RUNTIME_DIR"

# Apply the saved palette before starting Amane so it starts with the right
# colors instead of needing a second launch during login.
"$AMANE_DIR/scripts/apply-theme" >>"$RUNTIME_DIR/mako.log" 2>&1 || true

# Restore the selected X11 primary output and workspace 1's monitor rule.
if [[ -x "$AMANE_DIR/scripts/monitor-manager-menu" ]]; then
    "$AMANE_DIR/scripts/monitor-manager-menu" --apply-saved \
        >>"$RUNTIME_DIR/main-monitor.log" 2>&1 &
    disown "$!" 2>/dev/null || true
fi

# Start the installed bar once per login session.
AMANE_BIN="${XDG_BIN_HOME:-$HOME/.local/bin}/amane-shell"
if [[ -x "$AMANE_BIN" ]] && ! pgrep -u "${UID:-$(id -u)}" -x amane-shell >/dev/null 2>&1; then
    "$AMANE_BIN" >>"$RUNTIME_DIR/amane-shell.log" 2>&1 &
    disown "$!" 2>/dev/null || true
fi

# Clean up a tray-only Waybar instance left by the previous Amane setup.
TRAY_PID_FILE="$RUNTIME_DIR/amane-tray.pid"
if [[ -r "$TRAY_PID_FILE" ]]; then
    tray_pid="$(<"$TRAY_PID_FILE")"
    if [[ "$tray_pid" =~ ^[0-9]+$ ]] && kill -0 "$tray_pid" 2>/dev/null; then
        tray_command="$(ps -p "$tray_pid" -o args= 2>/dev/null || true)"
        if [[ "$tray_command" == *"waybar-tray.jsonc"* ]]; then
            kill "$tray_pid" 2>/dev/null || true
        fi
    fi
    rm -f "$TRAY_PID_FILE"
fi

if command -v hyprpaper >/dev/null 2>&1 && ! pgrep -u "${UID:-$(id -u)}" -x hyprpaper >/dev/null 2>&1; then
    hyprpaper >>"$RUNTIME_DIR/hyprpaper.log" 2>&1 &
    disown "$!" 2>/dev/null || true
fi

# Restore the global fallback first, then per-monitor choices override it.
# A state file holds the wallpaper's path, so its extension decides whether it
# is restored through Hyprpaper (images) or mpvpaper (videos).
# shellcheck source=wallpaper-lib
source "$AMANE_DIR/scripts/wallpaper-lib"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/amane"
WALLPAPER_STATE="$STATE_DIR/wallpaper"
MONITOR_WALLPAPER_STATE_DIR="$STATE_DIR/wallpapers-by-monitor"

global_wallpaper="$(read_state "$WALLPAPER_STATE")"
declare -A monitor_wallpapers=()
if [[ -d "$MONITOR_WALLPAPER_STATE_DIR" ]]; then
    while IFS= read -r -d '' monitor_state; do
        monitor="${monitor_state##*/}"
        [[ "$monitor" =~ ^[A-Za-z0-9_.:-]+$ ]] || continue
        monitor_wallpapers["$monitor"]="$(read_state "$monitor_state")"
    done < <(find "$MONITOR_WALLPAPER_STATE_DIR" -maxdepth 1 -type f -print0 2>/dev/null)
fi

if { [[ -n "$global_wallpaper" ]] || (( ${#monitor_wallpapers[@]} > 0 )); } \
    && command -v hyprctl >/dev/null 2>&1; then
    want_images=0
    want_videos=0
    for wallpaper in "$global_wallpaper" "${monitor_wallpapers[@]}"; do
        [[ -n "$wallpaper" ]] || continue
        if wallpaper_is_video "$wallpaper"; then want_videos=1; else want_images=1; fi
    done
    monitors="$(hyprctl -j monitors 2>/dev/null || true)"

    if (( want_images )) && command -v hyprpaper >/dev/null 2>&1; then
        # Hyprpaper's IPC socket may appear several seconds after its process.
        ready=0
        for _attempt in {1..60}; do
            if hyprctl hyprpaper listactive >/dev/null 2>&1; then
                ready=1
                break
            fi
            sleep 0.5
        done

        if (( ready == 0 )); then
            printf 'Could not restore saved wallpapers: Hyprpaper IPC did not become available.\n' \
                >>"$RUNTIME_DIR/hyprpaper.log"
        else
            if [[ -n "$global_wallpaper" ]] && ! wallpaper_is_video "$global_wallpaper"; then
                if [[ -f "$global_wallpaper" ]]; then
                    if ! hyprctl hyprpaper wallpaper ",${global_wallpaper},cover" >>"$RUNTIME_DIR/hyprpaper.log" 2>&1; then
                        printf 'Could not restore fallback wallpaper: %s\n' "$global_wallpaper" \
                            >>"$RUNTIME_DIR/hyprpaper.log"
                    fi
                else
                    printf 'Saved wallpaper is missing: %s\n' "$global_wallpaper" >>"$RUNTIME_DIR/hyprpaper.log"
                fi
            fi

            if command -v jq >/dev/null 2>&1; then
                for monitor in "${!monitor_wallpapers[@]}"; do
                    wallpaper="${monitor_wallpapers[$monitor]}"
                    if wallpaper_is_video "$wallpaper"; then
                        continue
                    fi
                    if [[ ! -f "$wallpaper" ]]; then
                        printf 'Saved wallpaper for %s is missing: %s\n' "$monitor" "$wallpaper" \
                            >>"$RUNTIME_DIR/hyprpaper.log"
                        continue
                    fi
                    if ! jq -e --arg monitor "$monitor" 'any(.[]; .name == $monitor)' \
                        <<<"$monitors" >/dev/null 2>&1; then
                        printf 'Saved wallpaper monitor is not connected: %s\n' "$monitor" \
                            >>"$RUNTIME_DIR/hyprpaper.log"
                        continue
                    fi
                    if ! hyprctl hyprpaper wallpaper "${monitor},${wallpaper},cover" \
                        >>"$RUNTIME_DIR/hyprpaper.log" 2>&1; then
                        printf 'Could not restore wallpaper for %s: %s\n' "$monitor" "$wallpaper" \
                            >>"$RUNTIME_DIR/hyprpaper.log"
                    fi
                done
            fi
        fi
    fi

    # Videos start after the images so their surfaces are created on top of
    # anything Hyprpaper drew. Each connected monitor plays its own saved video,
    # or the global one when it has no override of its own.
    if (( want_videos )); then
        if ! command -v mpvpaper >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
            printf 'Could not restore video wallpapers: mpvpaper and jq are both required.\n' \
                >>"$MPVPAPER_LOG"
        else
            while IFS= read -r monitor; do
                wallpaper="${monitor_wallpapers[$monitor]:-$global_wallpaper}"
                if [[ -z "$wallpaper" ]] || ! wallpaper_is_video "$wallpaper"; then
                    continue
                fi
                if [[ ! -f "$wallpaper" ]]; then
                    printf 'Saved video wallpaper for %s is missing: %s\n' "$monitor" "$wallpaper" \
                        >>"$MPVPAPER_LOG"
                    continue
                fi
                if ! mpvpaper_start "$monitor" "$wallpaper"; then
                    printf 'Could not restore video wallpaper for %s: %s\n' "$monitor" "$wallpaper" \
                        >>"$MPVPAPER_LOG"
                fi
            done < <(jq -r '.[].name' <<<"$monitors")
        fi
    fi
fi
